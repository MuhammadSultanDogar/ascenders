# Contact form uses FormSubmit (free) — no API key required by default.
# Submissions go to business@eascenders.com automatically.

# Optional: Web3Forms access key (also free) — overrides FormSubmit if set
# Get one at https://web3forms.com
# WEB3FORMS_ACCESS_KEY=your_access_key_here

# Optional override for recipient
# CONTACT_TO_EMAIL=business@eascenders.com
