# Optional — Web3Forms (free, reliable, recommended once FormSubmit activation is annoying)
# 1. Go to https://web3forms.com
# 2. Enter business@eascenders.com → get free access key
# 3. Uncomment and paste below, restart dev server
# WEB3FORMS_ACCESS_KEY=your_access_key_here

# Site URL used when forwarding form requests (production)
NEXT_PUBLIC_SITE_URL=https://eascenders.com

# Recipient override (FormSubmit / Web3Forms)
CONTACT_TO_EMAIL=business@eascenders.com
