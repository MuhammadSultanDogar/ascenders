# ─── Contact form (free) ────────────────────────────────────────────────────
#
# FormSubmit (default): activates PER DOMAIN. localhost ≠ www.eascenders.com
# After deploying, submit once on the live site and activate via email.
#
# Web3Forms (recommended for production — one key, all domains):
# 1. https://web3forms.com → enter business@eascenders.com → get access key
# 2. Add to Vercel → Settings → Environment Variables → redeploy
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your_access_key_here
